{
  "expo": {
    "name": "PROSTAFF",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ishtopish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.prostaff.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "yandexmaps",
          "yandexnavi",
          "tg"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.prostaff.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0D0D0D",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 88
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PROSTAFF sizga eng yaqin ishchilarni topish uchun joylashuvingizdan foydalanadi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PROSTAFF buyurtmaga rasm biriktirish uchun galereyaga ruxsat so'raydi."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm.wav"
          ],
          "color": "#534AB7",
          "defaultChannel": "orders",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30d8412d-e118-4d08-b784-e1a75e1fc0b1"
      }
    }
  }
}
